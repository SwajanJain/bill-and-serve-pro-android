# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Database
DB_PATH=./data/restaurant.db
DB_CLIENT=sqlite
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bill_and_serve_pro

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-in-production

# CORS
FRONTEND_URL=http://localhost:5173

# Static web hosting (single URL mode)
ENABLE_WEB_STATIC=true
WEB_DIST_PATH=../dist

# Backup Configuration
BACKUP_DIR=./backups
MAX_BACKUPS=30
USB_BACKUP_DIR=/media/usb/pos-backups
ENABLE_BACKUP_SCHEDULER=true
